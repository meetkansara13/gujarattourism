# Copy this file to .env. Never commit the real .env file.
DJANGO_SECRET_KEY=replace-with-a-new-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Use a fresh Gmail App Password or a transactional-email provider credential.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Gujarat Tourism <your-email@example.com>

GEMINI_API_KEY=replace-with-a-new-gemini-api-key
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
